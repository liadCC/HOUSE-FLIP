<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the game's pure logic outside Unity.

    Compiles the real runtime sources from Assets/_Scripts against the hand-written
    Unity stubs in Stubs/, so the assertions run on the same code the game ships.
    Editor-only scripts are excluded: they are the asset generators and they need a
    live AssetDatabase to mean anything.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The stubs are intentionally full of unused fields and empty events. -->
    <NoWarn>CS0067;CS0649;CS0414;CS0169;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Stubs/**/*.cs" />
    <Compile Include="Tests/**/*.cs" />
    <Compile Include="../../Assets/_Scripts/**/*.cs" Exclude="../../Assets/_Scripts/Editor/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
